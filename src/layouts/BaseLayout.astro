---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  section?: 'home' | 'start' | 'explore' | 'deep' | 'practice';
  type?: 'website' | 'article';
  dateModified?: string;
}

const {
  title,
  description,
  section = 'home',
  type = 'website',
  dateModified
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(`${base}/`, Astro.site);
const fullTitle = title === 'Agentic Engineering Field Guide' ? title : `${title} — Agentic Engineering Field Guide`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: 'Agentic Engineering Field Guide',
      description: 'A progressive guide and reference for trustworthy, architecture-aware Agentic Engineering.'
    },
    {
      '@type': type === 'article' ? 'TechArticle' : 'WebPage',
      '@id': `${canonical.href}#page`,
      url: canonical.href,
      name: fullTitle,
      description,
      isPartOf: { '@id': `${siteUrl.href}#website` },
      ...(dateModified ? { dateModified } : {})
    }
  ]
};

const nav = [
  ['start', 'Start Here', `${base}/start/`],
  ['explore', 'Explore the System', `${base}/explore/`],
  ['deep', 'Go Deeper', `${base}/deep/`],
  ['practice', 'Learn by Doing', `${base}/practice/`]
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07111d" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Agentic Engineering Field Guide" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href={`${base}/`} aria-label="Agentic Engineering Field Guide home">
          <span class="brand-mark">AE</span>
          <span>Agentic Engineering Field Guide</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          {nav.map(([id, label, href]) => (
            <a href={href} aria-current={section === id ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="shell footer-row">
        <span>Agentic Engineering Field Guide</span>
        <span>Content: CC BY 4.0 · Site code: Apache-2.0</span>
      </div>
    </footer>
  </body>
</html>
