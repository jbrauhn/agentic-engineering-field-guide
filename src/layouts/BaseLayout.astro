---
import '../styles/global.css';
import '../styles/navigation.css';
import SearchOverlay from '../components/SearchOverlay.astro';
import { journeys, sectionMeta, sitePath, type SectionId } from '../data/navigation';

interface PageControl {
  href: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  section?: SectionId | 'home';
  type?: 'website' | 'article';
  keywords?: string[];
  pageNavigation?: {
    previous: PageControl;
    next: PageControl;
    counter: string;
  };
}

const {
  title,
  description,
  section = 'home',
  type = 'website',
  keywords = ['Agentic Engineering', 'AI agents', 'software engineering', 'AI engineering'],
  pageNavigation
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(`${base}/`, Astro.site);
const fullTitle = title === 'Agentic Engineering Field Guide' ? title : `${title} — Agentic Engineering Field Guide`;
const licenseUrl = 'https://creativecommons.org/licenses/by/4.0/';
const sourceUrl = 'https://github.com/jbrauhn/agentic-engineering-field-guide';
const primarySections = ['start', 'explore', 'deep', 'practice'] as SectionId[];
const aboutActive = Astro.url.pathname.includes('/about');
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: 'Agentic Engineering Field Guide',
      description: 'A progressive guide and reference for trustworthy, architecture-aware Agentic Engineering.',
      inLanguage: 'en',
      isAccessibleForFree: true,
      license: licenseUrl
    },
    {
      '@type': type === 'article' ? 'TechArticle' : 'WebPage',
      '@id': `${canonical.href}#page`,
      url: canonical.href,
      name: fullTitle,
      headline: title,
      description,
      keywords,
      inLanguage: 'en',
      isAccessibleForFree: true,
      license: licenseUrl,
      isPartOf: { '@id': `${siteUrl.href}#website` },
      author: {
        '@type': 'Person',
        name: 'jbrauhn',
        url: 'https://github.com/jbrauhn'
      }
    }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07111d" />
    <meta name="color-scheme" content="dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="jbrauhn" />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={`${base}/sitemap-index.xml`} />
    <link rel="license" href={licenseUrl} />
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Agentic Engineering Field Guide" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body data-base={base}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="shell nav-shell">
        <div class="brand-group">
          <a class="brand" href={sitePath('/')} aria-label="Agentic Engineering Field Guide home">
            <span class="brand-mark">AE</span>
            <span class="brand-copy"><strong>Agentic Engineering</strong><small>Field Guide</small></span>
          </a>
          <details class:list={['brand-info','nav-dropdown',{active:aboutActive}]}>
            <summary aria-label="Open About and Evolution" title="About & Evolution">▾</summary>
            <div class="nav-dropdown-menu brand-info-menu">
              <a class="menu-overview" href={sitePath('/about.html')} aria-current={Astro.url.pathname.endsWith('/about.html') ? 'page' : undefined}>
                About & Evolution<small>Purpose, provenance, licensing, and how this living guide changes.</small>
              </a>
              <a href={sitePath('/about/system-summary.html')} aria-current={Astro.url.pathname.endsWith('/about/system-summary.html') ? 'page' : undefined}>
                AE System Summary<small>What it is, highest-level flow, capabilities, and portability.</small>
              </a>
              <a href={sitePath('/about/decisions.html')} aria-current={Astro.url.pathname.endsWith('/about/decisions.html') ? 'page' : undefined}>
                Decision Register<small>The decisions and reasoning behind the system.</small>
              </a>
              <a href={sitePath('/about/experiments.html')} aria-current={Astro.url.pathname.endsWith('/about/experiments.html') ? 'page' : undefined}>
                Experiments & Learnings<small>Open questions, evidence, conclusions, and updates.</small>
              </a>
              <a href={sourceUrl}>Field Guide source<small>Branches, pull requests, and public change history.</small></a>
            </div>
          </details>
        </div>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {primarySections.map((id) => {
            const topicPages = id === 'practice' ? [] : journeys[id];
            return (
              <div class:list={['nav-group', { active: section === id }]}>
                <a class="nav-section-link" href={sitePath(sectionMeta[id].landing)} aria-current={section === id ? 'page' : undefined}>{sectionMeta[id].label}</a>
                <details class="nav-dropdown">
                  <summary aria-label={`Open ${sectionMeta[id].label} topics`} title={`Open ${sectionMeta[id].label} topics`}>▾</summary>
                  <div class="nav-dropdown-menu">
                    <a class="menu-overview" href={sitePath(sectionMeta[id].landing)}>{sectionMeta[id].label} overview<small>{sectionMeta[id].description}</small></a>
                    {topicPages.map((page) => (
                      <a href={sitePath(page.path)} aria-current={Astro.url.pathname.endsWith(page.path) ? 'page' : undefined}>{page.title}<small>{page.short}</small></a>
                    ))}
                  </div>
                </details>
              </div>
            );
          })}
        </nav>
        <div class="nav-actions">
          {pageNavigation && (
            <div class="top-page-controls" aria-label="Topic navigation">
              <a class="top-page-button" href={pageNavigation.previous.href} title={`Previous: ${pageNavigation.previous.title}`} aria-label={`Previous: ${pageNavigation.previous.title}`} data-top-prev>
                ← <span>Previous</span>
              </a>
              <span class="top-page-counter" aria-label={`Page ${pageNavigation.counter}`}>{pageNavigation.counter}</span>
              <a class="top-page-button" href={pageNavigation.next.href} title={`Next: ${pageNavigation.next.title}`} aria-label={`Next: ${pageNavigation.next.title}`} data-top-next>
                <span>Next</span> →
              </a>
            </div>
          )}
          <SearchOverlay />
          <details class="mobile-menu">
            <summary aria-label="Open navigation">Menu</summary>
            <nav aria-label="Mobile navigation">
              <details class="mobile-section" open={aboutActive}>
                <summary>About & Evolution</summary>
                <div class="mobile-section-links">
                  <a class="mobile-overview" href={sitePath('/about.html')}>About & Evolution overview</a>
                  <a href={sitePath('/about/system-summary.html')}>AE System Summary</a>
                  <a href={sitePath('/about/decisions.html')}>Decision Register</a>
                  <a href={sitePath('/about/experiments.html')}>Experiments & Learnings</a>
                </div>
              </details>
              {primarySections.map((id) => {
                const topicPages = id === 'practice' ? [] : journeys[id];
                return (
                  <details class="mobile-section" open={section === id}>
                    <summary>{sectionMeta[id].label}</summary>
                    <div class="mobile-section-links">
                      <a class="mobile-overview" href={sitePath(sectionMeta[id].landing)}>{sectionMeta[id].label} overview</a>
                      {topicPages.map((page) => <a href={sitePath(page.path)}>{page.title}</a>)}
                    </div>
                  </details>
                );
              })}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer" data-pagefind-ignore>
      <div class="shell footer-grid">
        <div>
          <strong>Agentic Engineering Field Guide</strong>
          <p>AI changes the scale of engineering—not the need for engineering discipline.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href={sitePath('/about.html')}>About & Evolution</a>
          <a href={sitePath('/about/decisions.html')}>Decision Register</a>
          <a href={sourceUrl}>GitHub source</a>
          <a href={sitePath('/llms.txt')}>AI-readable guide map</a>
        </nav>
        <p class="license-note">Learning/reference content: CC BY 4.0<br />Site code: Apache-2.0</p>
      </div>
    </footer>
    <script>
      const desktopDropdowns = Array.from(document.querySelectorAll('.nav-dropdown'));
      desktopDropdowns.forEach((dropdown) => {
        dropdown.addEventListener('toggle', () => {
          if (!(dropdown instanceof HTMLDetailsElement) || !dropdown.open) return;
          desktopDropdowns.forEach((other) => {
            if (other instanceof HTMLDetailsElement && other !== dropdown) other.open = false;
          });
        });
      });
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        desktopDropdowns.forEach((dropdown) => {
          if (dropdown instanceof HTMLDetailsElement && dropdown.open && !dropdown.contains(target)) dropdown.open = false;
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        desktopDropdowns.forEach((dropdown) => {
          if (dropdown instanceof HTMLDetailsElement) dropdown.open = false;
        });
      });

      // External destinations are supporting references, not exits from the Field Guide.
      // Keep the guide open and put outside HTTP(S) destinations in a new tab.
      document.querySelectorAll('a[href]').forEach((anchor) => {
        if (!(anchor instanceof HTMLAnchorElement)) return;
        const raw = anchor.getAttribute('href');
        if (!raw || raw.startsWith('#') || raw.startsWith('mailto:') || raw.startsWith('tel:')) return;
        try {
          const destination = new URL(anchor.href, location.href);
          if ((destination.protocol === 'http:' || destination.protocol === 'https:') && destination.origin !== location.origin) {
            anchor.target = '_blank';
            anchor.rel = 'noopener noreferrer';
          }
        } catch {
          // Ignore malformed/non-navigation href values rather than breaking the page shell.
        }
      });
    </script>
  </body>
</html>
