---
import BaseLayout from './BaseLayout.astro';
import { journeys, sectionMeta, sitePath, relativeSitePath, type SectionId } from '../data/navigation';
import '../styles/deep.css';

const { frontmatter } = Astro.props;
const section = frontmatter.section as 'start' | 'explore' | 'deep';
const pages = journeys[section];
const currentPath = relativeSitePath(Astro.url.pathname);
const index = pages.findIndex((page) => page.path === currentPath);
const previous = index > 0 ? pages[index - 1] : null;
const next = index >= 0 && index < pages.length - 1 ? pages[index + 1] : null;
const progress = index >= 0 ? ((index + 1) / pages.length) * 100 : 0;
const landing = sectionMeta[section].landing;
const keywords = frontmatter.keywords || ['Agentic Engineering', sectionMeta[section].label];
const isDeep = section === 'deep';
const previousControl = previous
  ? { href: sitePath(previous.path), title: previous.title }
  : { href: sitePath(landing), title: `${sectionMeta[section].label} overview` };
const nextControl = next
  ? { href: sitePath(next.path), title: next.title }
  : { href: sitePath('/'), title: 'Choose another learning path' };
const pageNavigation = {
  previous: previousControl,
  next: nextControl,
  counter: `${index + 1} / ${pages.length}`
};
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} section={section as SectionId} type="article" keywords={keywords} pageNavigation={pageNavigation}>
  <main id="main-content" class:list={{ 'deep-guide': isDeep }} data-deep-mode={isDeep ? 'how' : undefined}>
    <header class="article-hero shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href={sitePath('/')}>Field Guide</a><span aria-hidden="true">/</span><a href={sitePath(landing)}>{sectionMeta[section].label}</a>
      </nav>
      <p class="kicker">{frontmatter.kicker}</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="lede">{frontmatter.description}</p>}
      <div class="journey-status" data-pagefind-ignore>
        <div class="progress-copy"><span>{sectionMeta[section].label}</span><span>{index + 1} of {pages.length}</span></div>
        <div class="progress-track" aria-hidden="true"><span style={`width:${progress}%`}></span></div>
      </div>
      <details class="journey-map" data-pagefind-ignore>
        <summary>Journey map <span>See all {pages.length} pages</span></summary>
        <ol>
          {pages.map((page, i) => (
            <li class:list={{ current: i === index }}>
              <a href={sitePath(page.path)} aria-current={i === index ? 'page' : undefined}>
                <span class="journey-number">{String(i + 1).padStart(2, '0')}</span>
                <span><strong>{page.title}</strong><small>{page.short}</small></span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    </header>
    {isDeep && (
      <div class="deep-modebar" data-pagefind-ignore aria-label="Deep reference reading mode">
        <div class="deep-mode-copy">
          <span class="mode-label">Reading mode</span>
          <span class="split-mode-help">In Split View, click a section on either side to pull the other pane to its related section.</span>
        </div>
        <div class="deep-mode-buttons" role="group" aria-label="Choose deep reference view">
          <button class="deep-mode-button" type="button" data-mode="how" aria-pressed="true">How it works</button>
          <button class="deep-mode-button" type="button" data-mode="work" aria-pressed="false">How we work</button>
          <button class="deep-mode-button" type="button" data-mode="split" aria-pressed="false">Split View</button>
        </div>
      </div>
    )}
    <article class:list={['prose','shell',{'deep-article':isDeep}]} data-pagefind-body data-deep-mode={isDeep ? 'how' : undefined}>
      <slot />
    </article>
    {isDeep ? (
      <nav class="page-nav shell deep-page-nav" aria-label="Deep reference navigation" data-pagefind-ignore>
        <a class="page-nav-card prev deep-topic-prev" href={previousControl.href} data-prev-link>
          <span>← Previous topic</span><strong>{previousControl.title}</strong>
        </a>
        <button class="page-nav-card prev deep-mode-prev" type="button" data-set-deep-mode="how">
          <span>← Previous</span><strong>How it works</strong>
        </button>
        <button class="page-nav-card next deep-mode-next" type="button" data-set-deep-mode="work">
          <span>Next →</span><strong>How we work</strong>
        </button>
        <a class="page-nav-card next deep-topic-next" href={nextControl.href} data-next-link>
          <span>{next ? 'Next topic →' : 'Continue →'}</span><strong>{nextControl.title}</strong>
        </a>
      </nav>
    ) : (
      <nav class="page-nav shell" aria-label="Page navigation" data-pagefind-ignore>
        <a class="page-nav-card prev" href={previousControl.href} data-prev-link>
          <span>{previous ? '← Previous' : `← ${sectionMeta[section].label}`}</span><strong>{previousControl.title}</strong>
        </a>
        <a class="page-nav-card next" href={nextControl.href} data-next-link>
          <span>{next ? 'Next →' : 'Continue →'}</span><strong>{nextControl.title}</strong>
        </a>
      </nav>
    )}
  </main>
  <script>
    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      const target = event.target;
      const typing = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || target?.isContentEditable;
      if (typing) return;
      const previous = document.querySelector('[data-top-prev]');
      const next = document.querySelector('[data-top-next]');
      if (event.key === 'ArrowLeft' || event.key === 'PageUp') {
        event.preventDefault();
        if (previous instanceof HTMLAnchorElement) location.href = previous.href;
      }
      if (event.key === 'ArrowRight' || event.key === 'PageDown') {
        event.preventDefault();
        if (next instanceof HTMLAnchorElement) location.href = next.href;
      }
      if (event.key.toLowerCase() === 'h') {
        event.preventDefault();
        location.href = document.body.dataset.base + '/';
      }
    });

    const deepGuide = document.querySelector('.deep-guide');
    const deepArticle = document.querySelector('.deep-article');
    const deepButtons = Array.from(document.querySelectorAll('.deep-mode-button'));
    if (deepGuide instanceof HTMLElement && deepArticle instanceof HTMLElement && deepButtons.length) {
      const storageKey = 'ae-deep-reading-mode-v2';
      const stored = localStorage.getItem(storageKey);
      const initial = stored === 'how' || stored === 'work' || stored === 'split' ? stored : 'how';
      const setMode = (mode, scrollToTop = false) => {
        deepGuide.dataset.deepMode = mode;
        deepArticle.dataset.deepMode = mode;
        deepButtons.forEach((button) => {
          if (button instanceof HTMLButtonElement) button.setAttribute('aria-pressed', button.dataset.mode === mode ? 'true' : 'false');
        });
        localStorage.setItem(storageKey, mode);
        if (scrollToTop) {
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          deepArticle.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
        }
      };
      setMode(initial);
      deepButtons.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.mode || 'how')));
      document.querySelectorAll('[data-set-deep-mode]').forEach((control) => {
        control.addEventListener('click', () => {
          if (control instanceof HTMLElement) setMode(control.dataset.setDeepMode || 'how', true);
        });
      });
      const topicNext = document.querySelector('.deep-topic-next');
      if (topicNext instanceof HTMLAnchorElement) {
        topicNext.addEventListener('click', () => {
          if (deepArticle.dataset.deepMode === 'work') localStorage.setItem(storageKey, 'how');
        });
      }

      // Split View is a linked conversation surface, not just two columns.
      // Clicking a section on either side pulls the opposite pane to the closest
      // related section. Explicit data-sync-key values can override the ordinal
      // relationship later; otherwise we map the relative position of the section.
      const howPane = deepArticle.querySelector('.deep-how');
      const workPane = deepArticle.querySelector('.deep-work');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const sectionsFor = (pane) => pane instanceof HTMLElement ? Array.from(pane.querySelectorAll(':scope > .deep-section')).filter((item) => item instanceof HTMLElement) : [];
      const clearRelated = () => deepArticle.querySelectorAll('.deep-section-related').forEach((item) => item.classList.remove('deep-section-related'));
      const scrollPaneTo = (pane, section) => {
        if (!(pane instanceof HTMLElement) || !(section instanceof HTMLElement)) return;
        const paneBox = pane.getBoundingClientRect();
        const sectionBox = section.getBoundingClientRect();
        const top = pane.scrollTop + sectionBox.top - paneBox.top - 70;
        pane.scrollTo({ top: Math.max(0, top), behavior: reducedMotion ? 'auto' : 'smooth' });
      };
      const relatedSection = (sourceSection, sourcePane, targetPane) => {
        const sourceSections = sectionsFor(sourcePane);
        const targetSections = sectionsFor(targetPane);
        if (!targetSections.length) return null;

        const explicit = sourceSection instanceof HTMLElement ? sourceSection.dataset.syncKey : undefined;
        if (explicit) {
          const matched = targetSections.find((item) => item instanceof HTMLElement && item.dataset.syncKey === explicit);
          if (matched instanceof HTMLElement) return matched;
        }

        const sourceIndex = sourceSections.indexOf(sourceSection);
        if (sourceIndex < 0 || sourceSections.length <= 1) return targetSections[0] instanceof HTMLElement ? targetSections[0] : null;
        const relativePosition = sourceIndex / (sourceSections.length - 1);
        const targetIndex = Math.round(relativePosition * Math.max(0, targetSections.length - 1));
        return targetSections[targetIndex] instanceof HTMLElement ? targetSections[targetIndex] : null;
      };
      const connectPane = (sourcePane, targetPane) => {
        if (!(sourcePane instanceof HTMLElement) || !(targetPane instanceof HTMLElement)) return;
        sourcePane.addEventListener('click', (event) => {
          if (deepArticle.dataset.deepMode !== 'split') return;
          const clicked = event.target;
          if (!(clicked instanceof Element)) return;
          if (clicked.closest('a,button,input,select,textarea,summary,code')) return;
          const sourceSection = clicked.closest('.deep-section');
          if (!(sourceSection instanceof HTMLElement)) return;
          const targetSection = relatedSection(sourceSection, sourcePane, targetPane);
          if (!(targetSection instanceof HTMLElement)) return;
          clearRelated();
          sourceSection.classList.add('deep-section-related');
          targetSection.classList.add('deep-section-related');
          scrollPaneTo(targetPane, targetSection);
        });
      };
      connectPane(howPane, workPane);
      connectPane(workPane, howPane);
    }
  </script>
</BaseLayout>
