---
import { conceptDestinations, type ConceptId } from '../data/concepts';
import { sitePath } from '../data/navigation';

interface Props {
  concept: ConceptId;
}

const { concept } = Astro.props;
const destination = conceptDestinations[concept];
---
<nav class="concept-depth-links" aria-label={`${destination.label} learning depth`} data-pagefind-ignore>
  <a href={sitePath(destination.explore)}>
    <span>Why</span>
    Explore the System →
  </a>
  <a href={sitePath(destination.deep)}>
    <span>Technical how</span>
    Go Deeper →
  </a>
</nav>

<style>
  .concept-depth-links {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--line-soft);
  }

  .concept-depth-links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 8px;
    border-radius: 9px;
    background: rgba(100, 191, 255, .06);
    color: var(--muted);
    font-size: .76rem;
    font-weight: 750;
    line-height: 1.25;
    text-decoration: none;
  }

  .concept-depth-links a:hover {
    background: rgba(100, 191, 255, .11);
    color: var(--text);
  }

  .concept-depth-links span {
    color: var(--orange);
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
</style>
